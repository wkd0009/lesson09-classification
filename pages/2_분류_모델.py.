import numpy as np
import pandas as pd
import plotly.graph_objects as go
import streamlit as st
from sklearn.dummy import DummyClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.tree import DecisionTreeClassifier

st.set_page_config(
    page_title="분류 모델 · 뇌졸중 예측 실습실",
    page_icon="🧪",
    layout="wide",
)

DATA_URL = "https://raw.githubusercontent.com/greatsong/modudata/main/data/stroke.csv"

# 열 이름 -> 우리말 이름
KOR = {
    "age": "나이",
    "avg_glucose_level": "평균 혈당",
    "bmi": "체질량지수",
    "hypertension": "고혈압",
    "heart_disease": "심장병",
}
ALL_FEATURES = list(KOR.keys())
DEFAULT_FEATURES = ["age", "avg_glucose_level", "hypertension", "heart_disease"]

LOGIT_NAME = "로지스틱 회귀(확률로 답하는 모델)"
TREE_NAME = "의사결정트리(질문으로 답하는 모델)"
BASE_NAME = "입력을 하나도 보지 않고 훈련용에서 많은 쪽으로만 답하는 모델"

COLOR_NEG = "#3b6fb6"  # 뇌졸중 아님 (점)
COLOR_POS = "#d62728"  # 뇌졸중 (점)
FILL_NEG = "rgba(173,205,245,0.45)"  # 트리 칸: 아님
FILL_POS = "rgba(245,170,170,0.50)"  # 트리 칸: 뇌졸중
NODE_NEG = "#cfe2f7"
NODE_POS = "#f7cccc"
FONT = "Malgun Gothic, Apple SD Gothic Neo, Noto Sans KR, sans-serif"


@st.cache_data
def load_data():
    return pd.read_csv(DATA_URL, encoding="utf-8")


def fmt_num(v):
    return f"{round(float(v), 2):g}"


def is_binary(values):
    return set(np.unique(values)).issubset({0, 1})


def accuracy_card(title, train_acc, test_acc, note=""):
    with st.container(border=True):
        html = (
            '<div style="text-align:center;">'
            f'<div style="font-size:0.95rem;font-weight:600;">{title}</div>'
            f'<div style="font-size:2.8rem;font-weight:700;line-height:1.3;">{test_acc * 100:.1f}%</div>'
            '<div style="font-size:0.8rem;opacity:0.75;">테스트 데이터 정확도</div>'
            '<div style="display:flex;justify-content:space-around;font-size:0.8rem;opacity:0.85;margin-top:8px;">'
            f"<span>훈련 데이터 {train_acc * 100:.1f}%</span>"
            f"<span>테스트 데이터 {test_acc * 100:.1f}%</span>"
            "</div>"
            f'<div style="font-size:0.75rem;opacity:0.65;margin-top:6px;">{note}</div>'
            "</div>"
        )
        st.markdown(html, unsafe_allow_html=True)


def build_dot(tree, X_train, y_train, names):
    """학습된 의사결정트리를 DOT 문자열로 바꾼다."""
    t = tree.tree_
    indicator = tree.decision_path(X_train)
    total = np.asarray(indicator.sum(axis=0)).ravel()
    pos = np.asarray(indicator.T.dot(y_train)).ravel()

    lines = [
        "digraph Tree {",
        "rankdir=TB;",
        f'node [shape=box, style="rounded,filled", fillcolor="white", fontname="{FONT}"];',
        f'edge [fontname="{FONT}"];',
    ]
    for i in range(t.node_count):
        stats = f"훈련 {int(total[i]):,}명 중 뇌졸중 {int(pos[i]):,}명 ({pos[i] / total[i] * 100:.1f}%)"
        if t.children_left[i] == -1:
            answer = tree.classes_[int(np.argmax(t.value[i][0]))]
            answer_text = "뇌졸중" if answer == 1 else "아님"
            fill = NODE_POS if answer == 1 else NODE_NEG
            label = f"답: {answer_text}\\n{stats}"
            lines.append(f'n{i} [label="{label}", fillcolor="{fill}"];')
        else:
            question = f"{names[t.feature[i]]} ≤ {fmt_num(t.threshold[i])}?"
            label = f"{question}\\n{stats}"
            lines.append(f'n{i} [label="{label}"];')
    for i in range(t.node_count):
        if t.children_left[i] != -1:
            lines.append(f'n{i} -> n{t.children_left[i]} [label="예"];')
            lines.append(f'n{i} -> n{t.children_right[i]} [label="아니요"];')
    lines.append("}")
    return "\n".join(lines)


# ---------------------------------------------------------------
# 제목
# ---------------------------------------------------------------
st.title("🧪 분류 모델")
st.caption("stroke가 1이면 뇌졸중(양성), 0이면 아님으로 두고, 두 가지 모델이 얼마나 잘 맞히는지 살펴봐요.")

try:
    df = load_data()
except Exception as e:
    st.error(f"데이터를 불러오지 못했어요. 인터넷 연결을 확인해 주세요. ({e})")
    st.stop()

# ---------------------------------------------------------------
# 1) 입력 속성 고르기
# ---------------------------------------------------------------
selected = st.multiselect(
    "입력으로 사용할 속성을 고르세요.",
    options=ALL_FEATURES,
    default=DEFAULT_FEATURES,
    format_func=lambda c: KOR[c],
)

if len(selected) < 2:
    st.info("입력으로 사용할 속성을 두 개 이상 골라 주세요.")
    st.stop()

names = [KOR[c] for c in selected]

# ---------------------------------------------------------------
# 2) 번호 순 정렬 -> 열 명씩 묶어 앞 세 명은 테스트용
# ---------------------------------------------------------------
data = df.sort_values("id").reset_index(drop=True)
is_test = (np.arange(len(data)) % 10) < 3

X_train = data.loc[~is_test, selected].astype(float).reset_index(drop=True)
X_test = data.loc[is_test, selected].astype(float).reset_index(drop=True)
y_train = data.loc[~is_test, "stroke"].to_numpy()
y_test = data.loc[is_test, "stroke"].to_numpy()

st.caption(
    f"전체 {len(data):,}명을 번호 순으로 정렬하고 열 명씩 묶어, 각 묶음의 앞 세 명을 테스트용으로 고정했어요. "
    f"테스트용 {len(X_test):,}명, 훈련용 {len(X_train):,}명이에요. 학습과 크기 맞추기는 훈련용으로만 해요."
)

# 체질량지수: 고른 경우에만 훈련용 중앙값으로 채우기
if "bmi" in selected:
    bmi_median = X_train["bmi"].median()
    n_fill_train = int(X_train["bmi"].isna().sum())
    n_fill_test = int(X_test["bmi"].isna().sum())
    X_train["bmi"] = X_train["bmi"].fillna(bmi_median)
    X_test["bmi"] = X_test["bmi"].fillna(bmi_median)
    st.caption(
        f"체질량지수는 빈 값이 있어 훈련용의 중앙값 {fmt_num(bmi_median)}으로 채웠어요 "
        f"(훈련용 {n_fill_train:,}명, 테스트용 {n_fill_test:,}명)."
    )

Xtr = X_train.to_numpy()
Xte = X_test.to_numpy()

# ---------------------------------------------------------------
# 3) 모델 만들기
# ---------------------------------------------------------------
scaler = StandardScaler().fit(Xtr)  # 크기 맞추기: 훈련용으로만
logit = LogisticRegression(max_iter=1000).fit(scaler.transform(Xtr), y_train)

tree = DecisionTreeClassifier(
    max_depth=3,  # 질문은 세 번까지
    min_samples_split=5,  # 사람이 다섯 명 미만인 마디는 더 나누지 않음
    random_state=42,  # 난수 고정
).fit(Xtr, y_train)

base = DummyClassifier(strategy="most_frequent").fit(Xtr, y_train)

logit_train = logit.score(scaler.transform(Xtr), y_train)
logit_test = logit.score(scaler.transform(Xte), y_test)
tree_train = tree.score(Xtr, y_train)
tree_test = tree.score(Xte, y_test)
base_train = base.score(Xtr, y_train)
base_test = base.score(Xte, y_test)
base_answer = "뇌졸중" if base.predict(Xte[:1])[0] == 1 else "뇌졸중 아님"

# ---------------------------------------------------------------
# 4) 정확도 카드
# ---------------------------------------------------------------
st.subheader("정확도 비교")
c1, c2, c3 = st.columns(3)
with c1:
    accuracy_card(LOGIT_NAME, logit_train, logit_test)
with c2:
    accuracy_card(TREE_NAME, tree_train, tree_test)
with c3:
    accuracy_card(BASE_NAME, base_train, base_test, note=f"항상 '{base_answer}'이라고 답해요.")

# ---------------------------------------------------------------
# 5) 산점도: 테스트 데이터 + 로지스틱 0.5 경계선 + 트리 칸
# ---------------------------------------------------------------
st.subheader("테스트 데이터 산점도")

col_x, col_y = st.columns(2)
with col_x:
    x_feat = st.selectbox("가로축", selected, index=0, format_func=lambda c: KOR[c])
with col_y:
    y_options = [c for c in selected if c != x_feat]
    y_feat = st.selectbox("세로축", y_options, index=0, format_func=lambda c: KOR[c])

xi = selected.index(x_feat)
yi = selected.index(y_feat)
medians = np.median(Xte, axis=0)  # 테스트 데이터의 중앙값


def axis_range(col):
    values = Xte[:, col]
    lo, hi = float(values.min()), float(values.max())
    if is_binary(values):
        pad = 0.3
    else:
        pad = (hi - lo) * 0.05 if hi > lo else 0.5
    return lo - pad, hi + pad


x_lo, x_hi = axis_range(xi)
y_lo, y_hi = axis_range(yi)
G = 160
xs = np.linspace(x_lo, x_hi, G)
ys = np.linspace(y_lo, y_hi, G)
XX, YY = np.meshgrid(xs, ys)

grid = np.tile(medians, (G * G, 1))
grid[:, xi] = XX.ravel()
grid[:, yi] = YY.ravel()

tree_pred = tree.predict(grid).reshape(G, G)
logit_z = logit.decision_function(scaler.transform(grid)).reshape(G, G)  # 0이면 확률 0.5

fig = go.Figure()

# 의사결정트리가 나눈 칸 (옅은 색)
fig.add_trace(
    go.Heatmap(
        x=xs,
        y=ys,
        z=tree_pred,
        zmin=0,
        zmax=1,
        colorscale=[[0, FILL_NEG], [1, FILL_POS]],
        showscale=False,
        hoverinfo="skip",
    )
)

# 로지스틱 회귀 0.5 경계선
line_inside = bool(logit_z.min() < 0 < logit_z.max())
if line_inside:
    fig.add_trace(
        go.Contour(
            x=xs,
            y=ys,
            z=logit_z,
            contours=dict(start=0, end=0, size=1, coloring="lines", showlabels=False),
            line=dict(color="black", width=3),
            showscale=False,
            showlegend=False,
            hoverinfo="skip",
        )
    )

# 테스트 데이터 점 (겹침을 줄이려고 0/1 속성은 화면에서만 살짝 흩뜨림)
rng = np.random.default_rng(0)
px_vals = Xte[:, xi].copy()
py_vals = Xte[:, yi].copy()
if is_binary(Xte[:, xi]):
    px_vals = px_vals + rng.uniform(-0.08, 0.08, len(px_vals))
if is_binary(Xte[:, yi]):
    py_vals = py_vals + rng.uniform(-0.08, 0.08, len(py_vals))

for label, value, color in [("뇌졸중 아님(0)", 0, COLOR_NEG), ("뇌졸중(1)", 1, COLOR_POS)]:
    mask = y_test == value
    fig.add_trace(
        go.Scatter(
            x=px_vals[mask],
            y=py_vals[mask],
            mode="markers",
            name=f"실제 {label}",
            marker=dict(color=color, size=6, opacity=0.7),
            customdata=np.column_stack([Xte[mask, xi], Xte[mask, yi]]),
            hovertemplate=f"{KOR[x_feat]}: %{{customdata[0]:g}}<br>{KOR[y_feat]}: %{{customdata[1]:g}}<extra>{label}</extra>",
        )
    )

# 범례용 안내 항목
if line_inside:
    fig.add_trace(
        go.Scatter(
            x=[None],
            y=[None],
            mode="lines",
            line=dict(color="black", width=3),
            name="로지스틱 회귀 0.5 경계선",
        )
    )
fig.add_trace(
    go.Scatter(
        x=[None],
        y=[None],
        mode="markers",
        marker=dict(symbol="square", size=12, color=FILL_NEG),
        name="의사결정트리 칸: 아님",
    )
)
fig.add_trace(
    go.Scatter(
        x=[None],
        y=[None],
        mode="markers",
        marker=dict(symbol="square", size=12, color=FILL_POS),
        name="의사결정트리 칸: 뇌졸중",
    )
)

x_axis = dict(title=KOR[x_feat], range=[x_lo, x_hi])
y_axis = dict(title=KOR[y_feat], range=[y_lo, y_hi])
if is_binary(Xte[:, xi]):
    x_axis.update(tickvals=[0, 1], ticktext=["없음", "있음"])
if is_binary(Xte[:, yi]):
    y_axis.update(tickvals=[0, 1], ticktext=["없음", "있음"])
fig.update_layout(
    xaxis=x_axis,
    yaxis=y_axis,
    legend_title_text="범례",
    height=520,
    margin=dict(l=10, r=10, t=30, b=10),
)
st.plotly_chart(fig, use_container_width=True)

others = [i for i in range(len(selected)) if i not in (xi, yi)]
if others:
    held = ", ".join(f"{names[i]} {fmt_num(medians[i])}" for i in others)
    st.write(f"그림에 쓰지 않은 속성은 테스트 데이터의 중앙값에 세워 두고 계산했어요: {held}")
else:
    st.write("고른 속성이 둘뿐이라, 따로 세워 둔 값은 없어요.")

if not line_inside:
    st.write("로지스틱 회귀(확률로 답하는 모델)가 0.5로 가르는 선은 이 그림 밖에 있어서 그려지지 않았어요.")

if any(is_binary(Xte[:, i]) for i in (xi, yi)):
    st.caption("0과 1만 있는 속성은 점이 겹치지 않도록 화면에서만 조금씩 흩뜨려 찍었어요.")

# ---------------------------------------------------------------
# 6) 의사결정트리가 던진 질문
# ---------------------------------------------------------------
st.subheader("의사결정트리가 던진 질문")
st.caption("예는 왼쪽 가지, 아니요는 오른쪽 가지예요. 마디마다 훈련용 사람 수와 그중 뇌졸중인 사람 수, 그 비율을 적었어요.")
st.graphviz_chart(build_dot(tree, Xtr, y_train, names), use_container_width=True)

t = tree.tree_
leaf_ids = [i for i in range(t.node_count) if t.children_left[i] == -1]
neg_leaves = [i for i in leaf_ids if tree.classes_[int(np.argmax(t.value[i][0]))] == 0]
st.write(
    f"답을 내는 마디(마지막 칸)는 모두 {len(leaf_ids)}칸이고, "
    f"그중 {len(neg_leaves)}칸이 '아님'이라고 답해요."
)

used = sorted(set(int(f) for f in t.feature if f >= 0))
if used:
    st.write(f"고른 속성 가운데 이 나무가 실제로 물은 것은 {', '.join(names[i] for i in used)}이에요.")
else:
    st.write("이 나무는 아무것도 묻지 않고 답을 냈어요.")
